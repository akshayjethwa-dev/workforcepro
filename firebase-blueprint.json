{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and authentication identity mapping with canonical RBAC roles, multi-role support, and branch scoping",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "RESELLER", "TENANT_ADMIN", "MANAGER", "WORKER", "FACTORY_OWNER", "SUPERVISOR", "CA"] },
        "roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["SUPER_ADMIN", "RESELLER", "TENANT_ADMIN", "MANAGER", "WORKER", "FACTORY_OWNER", "SUPERVISOR", "CA"] }
        },
        "tenantId": { "type": "string", "maxLength": 128 },
        "resellerId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "assignedBranchIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 }
        },
        "branchName": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "isActive": { "type": "boolean" },
        "roleVersion": { "type": "number" },
        "roleUpdatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Tenant organization record with subscription tier, branding, and soft-delete tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 256 },
        "resellerId": { "type": "string", "maxLength": 128 },
        "plan": { "type": "string", "enum": ["FREE", "STARTER", "PRO", "ENTERPRISE", "TRIAL"] },
        "isActive": { "type": "boolean" },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string", "maxLength": 128 },
        "recoveryExpiresAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyName", "plan"]
    },
    "Worker": {
      "title": "Worker",
      "description": "Worker profile partitioned strictly by tenantId and branchId",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 20 },
        "wageType": { "type": "string", "enum": ["DAILY", "MONTHLY", "PIECE_RATE"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "TERMINATED"] },
        "isActive": { "type": "boolean" },
        "deletedAt": { "type": "string" }
      },
      "required": ["id", "tenantId", "branchId", "name", "wageType"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance punch record partitioned strictly by tenantId and branchId",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "HALF_DAY", "WEEKLY_OFF", "ON_LEAVE", "HOLIDAY"] },
        "deletedAt": { "type": "string" }
      },
      "required": ["id", "tenantId", "branchId", "workerId", "date", "status"]
    },
    "Payroll": {
      "title": "Payroll",
      "description": "Monthly payroll run accessible strictly to TENANT_ADMIN and SUPER_ADMIN",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["DRAFT", "FINALIZED", "PAID"] }
      },
      "required": ["id", "tenantId", "month", "status"]
    },
    "OrgSettings": {
      "title": "OrgSettings",
      "description": "Tenant configuration (shifts, branches, statutory settings) writable only by TENANT_ADMIN and SUPER_ADMIN",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string", "maxLength": 128 },
        "enableBreakTracking": { "type": "boolean" }
      },
      "required": ["tenantId"]
    },
    "Advance": {
      "title": "Advance",
      "description": "Wage advance or kharchi record partitioned strictly by tenantId",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REPAID", "REJECTED"] }
      },
      "required": ["id", "tenantId", "workerId", "amount", "status"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Role-scoped invitation for branch managers, workers, or reseller clients",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "resellerId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "branchId": { "type": "string", "maxLength": 128 },
        "branchName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and data access audit trail entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "resource": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["SUCCESS", "DENIED", "ERROR"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "tenantId", "userId", "action", "resource", "status", "timestamp"]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Security incident notification for Super Admin review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "message": { "type": "string", "maxLength": 1000 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 256 },
        "actorRole": { "type": "string", "maxLength": 64 },
        "targetTenantId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["ACTIVE", "RESOLVED", "DISMISSED"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "type", "severity", "message", "actorId", "targetTenantId", "status", "timestamp"]
    },
    "MagicLink": {
      "title": "MagicLink",
      "description": "Scoped worker magic link token persisted by SHA-256 tokenHash document ID for cross-device verification",
      "type": "object",
      "properties": {
        "tokenHash": { "type": "string", "maxLength": 128 },
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "workerName": { "type": "string", "maxLength": 128 },
        "workerPhone": { "type": "string", "maxLength": 32 },
        "scope": { "type": "string", "enum": ["PAYSLIP", "SCHEDULE", "ATTENDANCE_SUMMARY", "PUNCH", "punch", "SALARY_RESTRUCTURE", "POSH_COMPLAINT"] },
        "channel": { "type": "string", "enum": ["WHATSAPP", "SMS", "COPY_LINK"] },
        "issuedBy": { "type": "string", "maxLength": 256 },
        "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "ttlHours": { "type": "number" },
        "targetMonth": { "type": "string", "maxLength": 16 },
        "shiftId": { "type": "string", "maxLength": 128 },
        "revoked": { "type": "boolean" },
        "revokedAt": { "type": "string" },
        "revokedBy": { "type": "string", "maxLength": 256 },
        "revocationReason": { "type": "string", "maxLength": 64 },
        "lastUsedAt": { "type": "string" },
        "accessLog": { "type": "array" },
        "flaggedMultiDevice": { "type": "boolean" },
        "flaggedReason": { "type": "string", "maxLength": 512 },
        "deliveryStatus": { "type": "string", "enum": ["DELIVERED", "FAILED", "PENDING"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["tokenHash", "tenantId", "workerId", "scope", "expiresAt", "revoked", "accessLog"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with canonical RBAC roles, multi-role list, tenantId, and assigned branchId"
    },
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Tenant organization accounts and soft-delete states"
    },
    "/workers/{workerId}": {
      "schema": "Worker",
      "description": "Worker profiles strictly isolated by tenantId and branchId"
    },
    "/attendance/{attId}": {
      "schema": "Attendance",
      "description": "Attendance logs strictly isolated by tenantId and branchId"
    },
    "/payroll/{payrollId}": {
      "schema": "Payroll",
      "description": "Monthly payroll ledgers restricted to TENANT_ADMIN and SUPER_ADMIN"
    },
    "/settings/{tenantId}": {
      "schema": "OrgSettings",
      "description": "Organization configuration writable only by TENANT_ADMIN and SUPER_ADMIN"
    },
    "/advances/{advId}": {
      "schema": "Advance",
      "description": "Wage advances strictly isolated by tenantId"
    },
    "/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Role-scoped user invitations"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable security and RBAC audit logs"
    },
    "/security_alerts/{alertId}": {
      "schema": "SecurityAlert",
      "description": "Super admin security incident alerts"
    },
    "/magicLinks/{tokenHash}": {
      "schema": "MagicLink",
      "description": "Cross-device worker magic link tokens keyed by SHA-256 tokenHash (raw bearer token is never persisted)"
    }
  }
}
